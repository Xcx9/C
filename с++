#include <iostream>
using namespace std;

class Student {
private:
	char* surname;
	char* name;

public:
	int group;
	int static count;

	Student()
	{
		count++;
		cout << "\nDefault constructor\n";
	};

	~Student()
	{
		free(name);
		free(surname);
	};

	void static printStatic();

	void add_stud() 
	{
		name = (char*)malloc(100 * sizeof(char));
		surname = (char*)malloc(100 * sizeof(char));
		
		int decision;
		cout << "Хотите добавить студентов?(1 - Да; 2 - Нет)\n";
		cin >> decision;
		while (decision == 1) {
			cout << "Введите фамилию студента: ";
			cin >> surname;
			cout << "Введите имя студента: ";
			cin >> name;
			cout << "Введите группу студента: ";
			cin >> group;
			this->name = name;
			this->surname = surname;
			this->group = group;
			cout << "Хотите добавить студентов?(1 - Да; 2 - Нет)\n";
			cin >> decision;
		}
	}

	void print_stud(Student* arr, int n)
	{
		printf("\nСписок студентов:\n===============================\n");
		for (int i = 0; i < n; i++)
		{
			printf("%s %s: %s\n", arr[i].name, arr[i].surname,
				arr[i].group);
		}
		printf("===============================\n");
	}

};


int Student::count = 0;


