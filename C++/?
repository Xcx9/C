void writeFile(const char filename[], Student* arr, int n)
{
    FILE* fp = fopen(filename, "w");
    if (fp)
    {
        for (int i = 0; i < n; i++)
            fprintf(fp, "%s %s %d\n", arr[i].name, arr[i].surname,
                arr[i].group);
        fclose(fp);
    }
    else
        perror("Some problems with file: ");
}

Student* readFile(const char filename[], int* n)
{
    Student* res = NULL;
    FILE* fp = fopen(filename, "r");
    if (fp)
    {
        int cap = 2;
        res = (Student*)malloc(cap * sizeof(Student));
        *n = 0;
        while (1)
        {
            if (*n >= cap) {
                cap *= 2;
                res = (Student*)realloc(res, cap * sizeof(Student));
            }
            res[*n].name = (char*)malloc(100 * sizeof(char));
            res[*n].surname = (char*)malloc(100 * sizeof(char));

            if (fscanf(fp, "%s %s %d\n", res[*n].name, res[*n].surname, res[*n].group) != 3)
                break;
            (*n)++;
        }
        fclose(fp);
    }
    else
        perror("Some problems with file: ");

    return res;
}

void find_by_group(Student* arr, int n)
{
    int k = 1;

    int search;
    std::cin >> search;
    printf("\nСтуденты по направлению '%s':\n", search);
    for (int i = 0; i < n; i++)
    {
        if (arr[i].group == search)
        {
            printf("%d)%s %s\n", k, arr[i].name, arr[i].surname);
            k++;
        }
    }
}

void find_by_name_surname(Student* arr, int n)
{
    char* name = (char*)malloc(100 * sizeof(char));
    char* surname = (char*)malloc(100 * sizeof(char));
    printf("Введите имя: ");
    cin >> name;
    printf("Введите фамилию: ");
    cin >> surname;
    int k = 1;
    printf("\nСтуденты с именем '%s' и фамилией '%s':\n", name, surname);
    for (int i = 0; i < n; i++)
    {
        if (!strcmp(arr[i].name, name) && !strcmp(arr[i].surname, surname))
        {
            printf("%d)%s %s: %s\n", k + 1, arr[i].name, arr[i].surname, arr[i].group);
            k++;
        }
    }
}
