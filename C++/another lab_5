    int charIndexSize;
    int* charIndexArray = createIndexArray(charArray, size, charK, charIndexSize);
    
    cout << "Indices of elements <= " << charK << " in char array:" << endl;
    for (int i = 0; i < charIndexSize; i++) {
        cout << charIndexArray[i] << " ";
    }
    cout << endl << endl;
    delete[] charIndexArray;
    
    // 3. Проконтролировать правильность работы явно перегруженной функции
    // (уже сделано при инициализации charArray)
    
    // Демонстрация работы шаблонного класса
    cout << "Demonstrating DynamicArray class:" << endl;
    
    // С массивом int
    DynamicArray<int> intArray(15, -50, 50);
    intArray.printArray();
    int* maxPosInt = intArray.findMaxPositive();
    if (maxPosInt) {
        cout << "Max positive element in int array: " << *maxPosInt << endl;
    } else {
        cout << "No positive elements in int array" << endl;
    }
    cout << endl;
    
    // С массивом double
    DynamicArray<double> dblArray(12, -100.0, 100.0);
    dblArray.printArray();
    double* maxPosDbl = dblArray.findMaxPositive();
    if (maxPosDbl) {
        cout << "Max positive element in double array: " << *maxPosDbl << endl;
    } else {
        cout << "No positive elements in double array" << endl;
    }
    
    // Освобождение памяти
    delete[] doubleArray;
    delete[] charArray;
    
    return 0;
}
