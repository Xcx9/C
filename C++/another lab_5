using namespace std;

// Шаблонная функция для инициализации массива случайными числами
template <typename T>
void initArray(T* arr, int size, T min, T max) {
    for (int i = 0; i < size; i++) {
        arr[i] = min + static_cast<T>(rand()) / (static_cast<T>(RAND_MAX / (max - min))));
    }
}

// Явная перегрузка для типа char
template <>
void initArray<char>(char* arr, int size, char min, char max) {
    for (int i = 0; i < size; i++) {
        arr[i] = 'a' + rand() % 26; // Случайные буквы латинского алфавита
    }
}

// Шаблонная функция для ввода числа K и создания массива индексов
template <typename T>
int* createIndexArray(const T* arr, int size, T K, int& resultSize) {
    resultSize = 0;
    // Сначала подсчитаем количество элементов <= K
    for (int i = 0; i < size; i++) {
        if (arr[i] <= K) {
            resultSize++;
        }
    }
    
    // Создаем массив индексов
    int* indexArray = new int[resultSize];
    int j = 0;
    for (int i = 0; i < size; i++) {
        if (arr[i] <= K) {
            indexArray[j++] = i;
        }
    }
    
    return indexArray;
}

// Шаблонный класс для работы с динамическими массивами
template <typename T>
class DynamicArray {
private:
    int n;    // размер массива
    T* Bp;    // начальный адрес
    T* Tp;    // рабочий указатель

public:
    // Конструктор
    DynamicArray(int size, T min, T max) : n(size) {
        Bp = new T[n];
        Tp = Bp;
        
        // Инициализация случайными числами
        for (int i = 0; i < n; i++) {
            Bp[i] = min + static_cast<T>(rand()) / (static_cast<T>(RAND_MAX / (max - min)));
        }
    }
    
    // Деструктор
    ~DynamicArray() {
        delete[] Bp;
    }
    
    // Печать массива
    void printArray() {
        cout << "Array (" << n << " elements):" << endl;
        for (int i = 0; i < n; i++) {
            cout << Bp[i] << "\t";
            if ((i + 1) % 5 == 0) cout << endl;
        }
        cout << endl;
    }
    
    // Поиск максимального положительного элемента
    T* findMaxPositive() {
        T* maxPos = nullptr;
        for (int i = 0; i < n; i++) {
            if (Bp[i] > 0) {
                if (maxPos == nullptr || Bp[i] > *maxPos) {
                    maxPos = &Bp[i];
                }
            }
        }
        return maxPos;
    }
};

int main() {
    srand(time(0)); // Инициализация генератора случайных чисел
    
