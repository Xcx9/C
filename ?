#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include <fstream>
#include <cstring>
#include <iomanip>
using namespace std;

class Student
{
private:
    char* name;
    char* surname;
public:
    int group;
    static int stud_cnt;

    Student() : name(nullptr), surname(nullptr), group(0) {
        stud_cnt++;
    }

    Student(const Student& other) {
        name = other.name;
        surname = other.surname;
        group = other.group;
        stud_cnt++;
    }

    Student& operator=(const Student& other) {
        if (this != &other) {
            free(name);
            free(surname);
            name = other.name;
            surname = other.surname;
            group = other.group;
        }
        return *this;
    }

    ~Student() {
        free(name);
        free(surname);
        stud_cnt--;
    }

    friend void find_by_group(Student* arr, int n);
    friend void find_by_name_surname(Student* arr, int n);
    friend void print(Student* arr, int n);
    friend void add_stud(Student* arr, int i);
    friend void writeFile(const char filename[], Student* arr, int n);
    friend Student* readFile(const char filename[], int* n);
    static void init() {
        cout << "Кол-во студентов: " << stud_cnt << endl;
    }
};

int Student::stud_cnt = 0;

bool fileExists(const std::string& filename) {
    ifstream file(filename);
    return file.good();
}

void writeFile(const char filename[], Student* arr, int n);
Student* readFile(const char filename[], int* n);

int main()
{
    system("chcp 1251");
    int n = 0;
    int cap = 2;
    Student* studs = new Student[cap];

    if (fileExists("stud")) {
        Student* loaded = readFile("stud", &n);
        delete[] studs;
        studs = loaded;
        cap = n;
    }
    else {
        cout << "Файл не найден\nЧтобы добавить студента, его направление и группу введите 'Добавить', окончание ввода - слово 'Все'\n";
        char buff[100];
        while (true) {
            cout << "Введите что-нибудь для добавления студента или 'все' для завершения: ";
            cin.getline(buff, 100);

            if (strcmp(buff, "все") == 0) break;

            if (n >= cap) {
                cap *= 2;
                Student* new_studs = new Student[cap];
                for (int i = 0; i < n; i++) new_studs[i] = studs[i];
                delete[] studs;
                studs = new_studs;
            }
            add_stud(studs, n);
            n++;
        }
    }

    print(studs, n);

    int search;
    cout << "Выберите тип поиска\nПо направлению - 1\nПо имени и фамилии - 2\nЧтобы ничего не искать введите что-то кроме 1 и 2\n";
    cin >> search;
    cin.ignore();

    switch (search) {
    case 1: 
        find_by_group(studs, n); 
        break;
    case 2: 
        find_by_name_surname(studs, n); 
        break;
    }

    writeFile("stud", studs, n);
    delete[] studs;
    return 0;
}

void add_stud(Student* arr, int i) {
    arr[i].name = (char*)malloc(100);
    arr[i].surname = (char*)malloc(100);

    cout << "\nВведите имя: ";
    cin >> setw(100) >> arr[i].name;

    cout << "Введите фамилию: ";
    cin >> setw(100) >> arr[i].surname;

    cout << "Введите номер группы: ";
    cin >> arr[i].group;
    cin.ignore();
}

void print(Student* arr, int n) {
    cout << "\nСписок студентов:\n===============================\n";
    for (int i = 0; i < n; i++) {
        cout << arr[i].name << " " << arr[i].surname << ": " << arr[i].group << endl;
    }
    cout << "===============================\n";
}

void writeFile(const char filename[], Student* arr, int n) {
    ofstream fp(filename);
    if (fp) {
        for (int i = 0; i < n; i++) {
            fp << arr[i].name << " " << arr[i].surname << " " << arr[i].group << endl;
        }
    }
    else {
        perror("Ошибка записи файла");
    }
}

Student* readFile(const char filename[], int* n) {
    Student* res = nullptr;
    ifstream fp(filename);
    *n = 0;
    int cap = 2;

    if (fp) {
        res = new Student[cap];
        while (true) {
            if (*n >= cap) {
                cap *= 2;
                Student* new_res = new Student[cap];
                for (int i = 0; i < *n; i++) new_res[i] = res[i];
                delete[] res;
                res = new_res;
            }

            res[*n].name = (char*)malloc(100);
            res[*n].surname = (char*)malloc(100);

            if (!(fp >> setw(100) >> res[*n].name >> setw(100) >> res[*n].surname >> res[*n].group)) {
                free(res[*n].name);
                free(res[*n].surname);
                break;
            }
            (*n)++;
        }
    }
    else {
        perror("Ошибка чтения файла");
    }
    return res;
}

void find_by_group(Student* arr, int n) {
    int search;
    cin >> search;
    cout << "\nСтуденты по направлению '" << search << "':\n";
    int k = 1;
    for (int i = 0; i < n; i++) {
        if (arr[i].group == search) {
            cout << k << ")" << arr[i].name << " " << arr[i].surname << endl;
            k++;
        }
    }
}

void find_by_name_surname(Student* arr, int n) {
    char name[100], surname[100];
    cout << "Введите имя: ";
    cin >> setw(100) >> name;
    cout << "Введите фамилию: ";
    cin >> setw(100) >> surname;

    cout << "\nСтуденты с именем '" << name << "' и фамилией '" << surname << "':\n";
    int k = 1;
    for (int i = 0; i < n; i++) {
        if (strcmp(arr[i].name, name) == 0 && strcmp(arr[i].surname, surname) == 0) {
            cout << k << ")" << arr[i].name << " " << arr[i].surname << ": " << arr[i].group << endl;
            k++;
        }
    }
}
