#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct
{
    char* name;
    char* surname;
} Fio;

typedef struct
{
    Fio fio;
    char* direction;
} Student;

void Add_Stud(Student* arr, int i);
void print(Student* arr, int n);
void find_by_direction(Student* arr, int n, char* direction);
void find_by_name_surname(Student* arr, int n, char* name, char* surname);
void writeFile(char filename[], Student* arr, int n);
Student* readFile(char filename[], int* n);

int main()
{
    system("chcp 1251");
    int n = 0;
    int cap = 2;
    Student* studs = (Student*)malloc(cap * sizeof(Student));
    if (access("stud", 0) != 0) {
        printf("Чтобы добавить студента, его направление и группу введите 'Добавить', окончание ввода - слово 'Все'\n");
        char buff[100];

        while (1) {
            printf("Введите что-нибудь для добавления студента или 'все' для завершения: ");
            fgets(buff, sizeof(buff), stdin);
            buff[strcspn(buff, "\n")] = 0;

            if (strcmp(buff, "все") == 0) {
                break;
            }

            if (n >= cap) {
                cap *= 2;
                studs = (Student*)realloc(studs, cap * sizeof(Student));
            }
            Add_Stud(studs, n);
            n++;
        }
    }
    else {
        studs = readFile("stud", &n);
    }
    // Вывод студентов
    print(studs, n);
    int search;
    printf("Выберите тип поиска\nПо направлению - 1\nПо имени и фамилии - 2\nЧтобы ничего не искать введите что-то кроме 1 и 2\n");
    scanf("%d", &search);
    getchar();

    char direction[100];
    char name[100];
    char surname[100];

    switch (search)
    {
    case 1:
        // Поиск по направлению
        printf("Введите направление: ");
        fgets(direction, sizeof(direction), stdin);
        direction[strcspn(direction, "\n")] = 0;
        find_by_direction(studs, n, direction);
        break;
    case 2:
        // Поиск по имени и фамилии
        printf("Введите имя: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = 0;
        printf("Введите фамилию: ");
        fgets(surname, sizeof(surname), stdin);
        surname[strcspn(surname, "\n")] = 0;
        find_by_name_surname(studs, n, name, surname);
        break;
    default:
        break;
    }

    writeFile("stud", studs, n);

    for (int i = 0; i < n; i++) {
        free(studs[i].fio.name);
        free(studs[i].fio.surname);
        free(studs[i].direction);
    }
    free(studs);

    return 0;
}

void Add_Stud(Student* arr, int i)
{
    arr[i].fio.name = (char*)malloc(100 * sizeof(char));
    arr[i].fio.surname = (char*)malloc(100 * sizeof(char));
    arr[i].direction = (char*)malloc(100 * sizeof(char));

    printf("\nВведите имя: ");
    fgets(arr[i].fio.name, 100, stdin);
    arr[i].fio.name[strcspn(arr[i].fio.name, "\n")] = 0;

    printf("Введите фамилию: ");
    fgets(arr[i].fio.surname, 100, stdin);
    arr[i].fio.surname[strcspn(arr[i].fio.surname, "\n")] = 0;

    printf("Введите направление: ");
    fgets(arr[i].direction, 100, stdin);
    arr[i].direction[strcspn(arr[i].direction, "\n")] = 0;
}

void print(Student* arr, int n)
{
    printf("\nСписок студентов:\n===============================\n");
    for (int i = 0; i < n; i++)
    {
        printf("%s %s: %s\n", arr[i].fio.name, arr[i].fio.surname,
            arr[i].direction);
    }
    printf("===============================\n");
}

void find_by_direction(Student* arr, int n, char* direction)
{
    int k = 1;
    printf("\nСтуденты по направлению '%s':\n", direction);
    for (int i = 0; i < n; i++)
    {
        if (!strcmp(arr[i].direction, direction))
        {
            printf("%d)%s %s\n", k, arr[i].fio.name, arr[i].fio.surname);
            k++;
        }
    }
}

void find_by_name_surname(Student* arr, int n, char* name, char* surname)
{
    int k = 1;
    printf("\nСтуденты с именем '%s' и фамилией '%s':\n", name, surname);
    for (int i = 0; i < n; i++)
    {
        if (!strcmp(arr[i].fio.name, name) && !strcmp(arr[i].fio.surname, surname))
        {
            printf("%d)%s %s: %s\n", k + 1, arr[i].fio.name, arr[i].fio.surname, arr[i].direction);
            k++;
        }
    }
}

void writeFile(char filename[], Student* arr, int n)
{
    FILE* fp = fopen(filename, "w");
    if (fp)
    {
        for (int i = 0; i < n; i++)
            fprintf(fp, "%s %s %s\n", arr[i].fio.name, arr[i].fio.surname,
                arr[i].direction);
        fclose(fp);
    }
    else
        perror("Some problems with file: ");
}

Student* readFile(char filename[], int* n)
{
    Student* res = NULL;
    FILE* fp = fopen(filename, "r");
    if (fp)
    {
        int cap = 2;
        res = (Student*)malloc(cap * sizeof(Student));
        *n = 0;

        while (1)
        {
            if (*n >= cap) {
                cap *= 2;
                res = (Student*)realloc(res, cap * sizeof(Student));
            }
            res[*n].fio.name = (char*)malloc(100 * sizeof(char));
            res[*n].fio.surname = (char*)malloc(100 * sizeof(char));
            res[*n].direction = (char*)malloc(100 * sizeof(char));

            if (fscanf(fp, "%s %s %s\n", res[*n].fio.name, res[*n].fio.surname,
                res[*n].direction) != 3)
                break;
            (*n)++;
        }
        fclose(fp);
    }
    else
        perror("Some problems with file: ");

    return res;
}
