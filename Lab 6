define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct
{
    char* name;
    char* surname;
    char* direction;
    int group;
} Student;

void Add_Stud(Student* arr, int i);
void print(Student* arr, int n);

int main()
{
    system("chcp 1251");
    int n = 0;
    int capacity = 2;
    Student* studs = (Student*)malloc(capacity * sizeof(Student));

    printf("Чтобы добавить студента, его направление и группу введите 'Добавить', окончание ввода - слово 'Все'\n");
    char buff[100]; // буфер для ввода

    while (1) {
        printf("Введите что-нибудь для добавления студента или 'Все' для завершения: ");
        gets(buff);

        if (strcmp(buff, "Все") == 0) {
            break;
        }

        if (n >= capacity) {
           capacity *= 2;
           studs = (Student*)realloc(studs, capacity * sizeof(Student));
        }
        Add_Stud(studs, n);
        n++;
    }

    print(studs, n);

    for (int i = 0; i < n; i++) {
        free(studs[i].name);
        free(studs[i].surname);
        free(studs[i].direction);
    }
    free(studs);

    return 0;
}

void Add_Stud(Student* arr, int i)
{
    arr[i].name = (char*)malloc(100 * sizeof(char));
    arr[i].surname = (char*)malloc(100 * sizeof(char));
    arr[i].direction = (char*)malloc(100 * sizeof(char));

    printf("\nВведите имя: ");
    gets(arr[i].name);
    printf("Введите фамилию: ");
    gets(arr[i].surname);
    printf("Введите направление: ");
    gets(arr[i].direction);
    printf("Введите номер группы: ");
    scanf("%d", &arr[i].group);
    getchar();
}

void print(Student* arr, int n)
{
    printf("\nСписок студентов:\n");
    for (int i = 0; i < n; i++)
    {
        printf("Имя: %s Фамилия: %s Направление: %s Группа: %d\n", arr[i].name, arr[i].surname, arr[i].direction, arr[i].group);
    }
}
