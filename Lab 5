// n - rows
// m - columns
int* cnt_dig(float** mat, float* arr, int n, int m);

int main()
{
	system("chcp 1251");
	srand(time(NULL));
	float** mat;
	int n, m, i = 0, j = 0;
	float* arr;
	arr = (float*)malloc(2 * sizeof(float));
	printf("Введите n и m\n");
	printf("n: ");
	scanf("%d", &n);
	printf("m: ");
	scanf("%d", &m);

	mat = (float**)malloc(sizeof(float*) * n);
	for (i = 0; i < n; i++) {
		mat[i] = (float*)malloc(m * sizeof(float));
	}

	for (i = 0; i < n; i++)
		for (j = 0; j < m; j++)
			mat[i][j] = (rand() % 20 - 10.0) / 10;

	for (i = 0; i < n; i++)
	{
		for (j = 0; j < m; j++)
			printf("%.2f\t", mat[i][j]);
		printf("\n");
	}

	cnt_dig(mat, arr, n, m);

	printf("min: %f\n", arr[0]);
	printf("max: %f\n", arr[1]);


	free(mat);
}

int* cnt_dig(float** mat, float* arr, int n, int m) {
	int i = 0, j = 0, k = 0, ser = (m - 1) / 2;
	float min = mat[0][0], max = mat[0][0];
	//printf("=========================\n");
	//printf("Left:\n");
	for (j; j < (m + 1) / 2; j++) { // columns
		for (i = j; i < n - k; i++) { // rows
			//printf("%.2f\t", mat[i][j]);
			if (mat[i][j] < min) {
				min = mat[i][j];
			}
		}
		k += 1;
	}

	//printf("Right:\n");
	k = ser + 1;
	for (j = (n - 1) / 2; j < n; j++) { // rows
		for (i = ser; i < k; i++) { // columns
			//printf("[%d] [%d] %.2f\t", i, j, mat[i][j]);
			if (mat[i][j] > max) {
				max = mat[i][j];
			}
		}
		ser -= 1;
		k += 1;
	}

	arr[0] = min;
	arr[1] = max;

	return arr;
}

