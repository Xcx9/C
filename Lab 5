char** set_smth(char** str, int k) {
	for (int i = 0; i < k; i++) {
		if ((i + 1) % 2 == 0) {
			size_t count = 1;
			memmove(str[i] + count, str[i], strlen(str[i]) + count);
			memset(str[i], '+', count);
		}
		else {
			int cnt = 0;
			char* word;
			char* words = (char*)malloc(strlen(str[i]) * 2 + 1);
			words[0] = '\0'; // Инициализируем words как пустую строку

			word = strtok(str[i], " ");
			while (word != NULL) {
				strcat(words, word);
				strcat(words, " ");
				strcat(words, word);
				strcat(words, " ");

				word = strtok(NULL, " ");
			}

			strcpy(str[i], words);
			//free(words);
		}
	}
	return str;
}

