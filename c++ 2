void Add_Stud(Student* arr, int i)
{
    arr[i].name = (char*)malloc(100 * sizeof(char));
    arr[i].surname = (char*)malloc(100 * sizeof(char));
    printf("\nВведите имя: ");
    cin >> arr[i].name;

    printf("Введите фамилию: ");
    cin >> arr[i].surname;

    printf("Введите направление: ");
    cin >> arr[i].group;
}

void print(Student* arr, int n)
{
    printf("\nСписок студентов:\n===============================\n");
    for (int i = 0; i < n; i++)
    {
        printf("%s %s: %s\n", arr[i].name, arr[i].surname,
            arr[i].group);
    }
    printf("===============================\n");
}





void writeFile(const char filename[], Student* arr, int n)
{
    FILE* fp = fopen(filename, "w");
    if (fp)
    {
        for (int i = 0; i < n; i++)
            fprintf(fp, "%s %s %d\n", arr[i].name, arr[i].surname,
                arr[i].group);
        fclose(fp);
    }
    else
        perror("Some problems with file: ");
}

Student* readFile(const char filename[], int* n)
{
    Student* res = NULL;
    FILE* fp = fopen(filename, "r");
    if (fp)
    {
        int cap = 2;
        res = (Student*)malloc(cap * sizeof(Student));
        *n = 0;
        while (1)
        {
            if (*n >= cap) {
                cap *= 2;
                res = (Student*)realloc(res, cap * sizeof(Student));
            }
            res[*n].name = (char*)malloc(100 * sizeof(char));
            res[*n].surname = (char*)malloc(100 * sizeof(char));

            if (fscanf(fp, "%s %s %d\n", res[*n].name, res[*n].surname,
                res[*n].group) != 3)
                break;
            (*n)++;
        }
        fclose(fp);
    }
    else
        perror("Some problems with file: ");

    return res;
}

